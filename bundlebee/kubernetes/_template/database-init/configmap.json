{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "{{bundlebee-lowercase:{{dbinit.name}}-init}}",
    "namespace": "{{namespace.name}}",
    "labels": {
      "app.kubernetes.io/name": "{{bundlebee-lowercase:{{dbinit.name}}-init}}",
      "app.kubernetes.io/part-of": "{{project.name}}",
      "app.kubernetes.io/managed-by": "bundlebee",
      "deploy.by": "{{user.name:-unknown}}",
      "deploy.at": "{{bundlebee.deploytime:-unset}}"
    },
    "annotations": {
      "io.yupiik.bundlebee/putOnUpdate": "true"
    }
  },
  "data": {
    {{bundlebee-directory-json-key-value-pairs-content:{{project.basedir}}/bundlebee/resources/sql/{{dbinit.name}}/*.sql}},
    "init_db.sh": "{{bundlebee-json-inline-file:{{project.basedir}}/bundlebee/resources/sql/init_db.sh}}"
  }
}
